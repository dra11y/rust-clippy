#![warn(clippy::uninlined_format_args)]

mod simple_tracing_like {
    // Test a few cases from tracing with complex patterns.
    // Complete coverage requires lintcheck CI test.
    macro_rules! info {
        // Name / target / parent.
        (name: $name:expr, target: $target:expr, parent: $parent:expr, { $($field:tt)* }, $($arg:tt)* ) => (
            println!($($arg)*)
        );

        // Name.
        (name: $name:expr, { $($field:tt)* }, $($arg:tt)* ) => (
            println!($($arg)*)
        );
        (name: $name:expr, $($arg:tt)+ ) => (
            println!($($arg)*)
        );

        // ...
        ({ $($field:tt)+ }, $($arg:tt)+ ) => (
            println!($($arg)*)
        );
        ($($arg:tt)+) => (
            println!($($arg)*)
        );
    }

    pub(crate) use info;
}

mod logging {
    // private inside module
    macro_rules! private { ($($t:tt)*) => { println!($($t)*); } }

    // exported from module
    #[macro_export]
    macro_rules! exported { ($($t:tt)*) => { println!($($t)*); } }

    // ambiguous in matched module
    macro_rules! ambiguous { ($($t:tt)*) => { println!($($t)*); } }

    // annotated and not included in `additional-format-macros`
    #[clippy::format_args]
    #[macro_export]
    macro_rules! annotated { ($($t:tt)*) => { println!($($t)*); } }

    pub(crate) use {ambiguous, private};
}

mod other {
    // ambiguous in unmatched module
    macro_rules! ambiguous { ($($t:tt)*) => { println!($($t)*); } }

    pub(crate) use ambiguous;
}

fn main() {
    let a = 1;
    let b = Some("test");

    logging::private!("{a}");
    //~^ uninlined_format_args

    logging::private!("{b:?}");
    //~^ uninlined_format_args

    logging::private!("{a}, {b:?}");
    //~^ uninlined_format_args

    logging::private!("{a}, {b:?}");
    //~^ uninlined_format_args

    exported!("{a}");
    //~^ uninlined_format_args

    annotated!("{a}");
    //~^ uninlined_format_args

    logging::ambiguous!("{a}");
    //~^ uninlined_format_args

    simple_tracing_like::info!(name: "test", "This is a test with {b:?}");
    //~^ uninlined_format_args

    simple_tracing_like::info!(name: "test", { b }, "This is a test with {a}");
    //~^ uninlined_format_args

    simple_tracing_like::info!(name: "test", target: "test_target", parent: "test_parent", { field1: "value1" }, "This is a test with {a}");
    //~^ uninlined_format_args

    simple_tracing_like::info!({ a, b }, "This is a test with {a}");
    //~^ uninlined_format_args

    simple_tracing_like::info!("This is a test with {b:?}");
    //~^ uninlined_format_args

    // Check for false positives

    logging::private!("{}, {:?}", a, b.clone());

    logging::private!("{a}, {:?}", b.clone());

    logging::private!("{a}, {b:?}");

    // Same name but different module
    other::ambiguous!("{}", a);

    simple_tracing_like::info!({ a }, "This is a test with {b:?}");

    simple_tracing_like::info!({ a, b }, "This is a test");

    simple_tracing_like::info!(name: "test", target: "test_target", parent: "test_parent", { field1: "value1" }, "This is a test with {a}");
}
